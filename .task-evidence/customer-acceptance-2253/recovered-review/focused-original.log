-rank b,.fois-score span{color:var(--text-secondary)}\n.ds-table-wrap{min-width:0;overscroll-behavior-x:contain}\n.pick-dossier{min-width:0;max-width:100%}.pick-dossier .metric{min-width:0}.pick-dossier .metric>b{overflow-wrap:anywhere;font-size:clamp(1rem,3vw,1.35rem)}.pick-dossier .dtos-explanation{overflow-wrap:anywhere}.pick-history-table{min-width:42rem}.pick-history-table th,.pick-history-table td{overflow-wrap:normal;word-break:normal}\n.grid{grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr))}\n.player-summary-copy .ds-position{display:inline-flex;margin-right:4px}\n.ds-position[data-position=QB]{color:#ffd0cc;background:#572a2a;border-color:#aa5555}\n.ds-position[data-position=RB]{color:#b6f2e7;background:#15443d;border-color:#328c7c}\n.ds-position[data-position=WR]{color:#cee3ff;background:#213f60;border-color:#5079aa}\n.ds-position[data-position=TE]{color:#ffecaf;background:#51421b;border-color:#ad8b32}\n@media(max-width:760px){.ux-feature{padding:16px}.ux-feature h2{font-size:27px}.ds-page-header .ds-actions{gap:8px}.ds-page-header .ds-action{padding:8px 12px}.league-standing{padding:10px;gap:8px}.league-points{font-size:11px}.ds-section-actions{display:grid;gap:8px}.summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n\n/* Compact shared chrome. Tool destinations stay in document flow when opened. */\n.ds-shell .top{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:8px;align-items:center}\n.ds-shell .top>*{min-width:0}.ds-shell .top .btn{padding:8px 10px;white-space:normal}\n.ds-shell .secondary-nav{margin:0}.ds-shell .secondary-nav>summary{padding:6px 8px;gap:6px;line-height:1.3}\n.ds-shell .secondary-nav>summary:before{content:"▸";color:var(--text-secondary)}\n.ds-shell .secondary-nav[open]{grid-column:1/-1;padding:8px 0}.ds-shell .secondary-nav[open]>summary:before{content:"▾"}\n.ds-shell .secondary-nav[open]>div{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(140px,100%),1fr));gap:8px}\n.ds-shell .account-context{padding:2px 0;margin:0 0 4px}.ds-shell .account-context summary{flex-wrap:wrap;overflow-wrap:anywhere}\n.ds-shell .manager-nav{margin-bottom:4px}\n.ds-page-header{gap:12px;margin:8px 0 16px;padding-bottom:12px}.ds-page-header:not([data-dtos-shell="account-onboarding"])>div:first-child{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px}\n.ds-page-header h1{margin:0}.ds-page-guide[open]{flex-basis:100%}.ds-page-guide .ds-actions{margin-top:8px}\n.ds-header-side .primary{background:transparent;color:var(--accent);border-color:var(--border-active)}\n.ds-overview-header{margin:8px 0}.ds-page-header--search,.ds-page-header--identity{display:block}\n.ds-page-header--identity h1{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}\n.ds-page-header--identity{border:0;margin:0;padding:0}\n.market-mode{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}.market-mode .ds-action{background:transparent;color:var(--text-secondary)}\n.market-mode [aria-current=page]{color:var(--accent);border-color:var(--border-active);background:rgba(128,223,66,.06)}\n.market-view-evidence{margin:8px 0;color:var(--text-secondary)}.market-view-evidence>summary{font-size:13px}\n.market-view-evidence p{max-width:68ch}.market-filters{margin:8px 0}.market-filters input,.market-filters select{width:100%;min-width:0}\n.market-filter-field{min-width:0}\n@media(max-width:760px){\n .ds-shell:has(.account-context) .brand p{display:none}.ds-shell .brand-mark{font-size:22px;letter-spacing:.08em}\n .ds-shell .secondary-nav>summary{max-width:104px;font-size:12px}.ds-shell .secondary-nav[open]>summary{max-width:none}\n .ds-shell .account-context summary{gap:2px 8px}.ds-shell .account-context summary span{min-width:0}\n .ds-page-header{gap:8px;margin:8px 0 12px;padding-bottom:8px}.ds-page-header h1{font-size:24px}\n .ds-page-header .ds-page-guide:not([open]){margin-left:auto}.ds-page-header--identity{margin:0;padding:0}\n .market-mode{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.market-mode .ds-action{padding:8px;font-size:13px;text-align:center}\n}\n@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}\n\n/* Customer presentation: answer, explanation, optional evidence. */\n.cx-lead{font-size:16px;line-height:1.55;max-width:65ch;margin:8px 0 16px}\n.cx-evidence{margin:12px 0;min-width:0;overflow-wrap:anywhere}\n.cx-evidence>summary{font-size:14px;font-weight:650;min-height:44px;cursor:pointer;color:var(--text-secondary)}\n.cx-evidence[open]>summary{color:var(--text-primary);margin-bottom:8px}\n.cx-evidence-body{padding:12px;border:1px solid var(--border);border-radius:var(--radius-sm);min-width:0}\n.cx-evidence-body p{line-height:1.55}.cx-evidence-body pre{max-height:320px;overflow:auto}\n.cx-section{margin:20px 0;min-width:0}.cx-section>h2{margin-bottom:12px}\n.cx-facts{display:flex;flex-wrap:wrap;gap:8px 20px;align-items:baseline}\n.cx-facts>div{min-width:0;max-width:100%;overflow-wrap:anywhere}\n.cx-status{padding:12px;border-left:3px solid var(--warning);background:var(--surface);line-height:1.55}\nhtml{scroll-padding-top:calc(72px + env(safe-area-inset-top))}\n:where(button,input,select,textarea,summary,a[id]){scroll-margin-bottom:100px;scroll-margin-top:12px}\n@media(max-width:760px){.cx-lead{font-size:16px}.cx-section{margin:16px 0}.cx-evidence-body{padding:10px}.top{flex-wrap:wrap}}\n\n\nbody.public-welcome{margin:0;font-size:16px;color:var(--text-primary);line-height:1.55}\n.public-welcome *{box-sizing:border-box}.public-welcome :is(h1,h2,h3,p,ul,ol,dl){overflow-wrap:anywhere}\n.public-welcome .pw-wrap{width:min(100%,1160px);margin:0 auto;padding:0 24px 32px;min-width:0}\n.public-welcome .pw-header{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:76px;border-bottom:1px solid var(--border)}\n.public-welcome .pw-brand{display:inline-flex;align-items:center;min-height:44px;font-size:24px;font-weight:800;letter-spacing:.1em}\n.public-welcome .pw-brand-d{color:var(--accent)}\n.public-welcome .pw-action{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:9px 16px;border:1px solid var(--border);border-radius:8px;font-weight:700;font-size:14px;text-align:center}\n.public-welcome .pw-action:hover{background:var(--surface-interactive)}\n.public-welcome .pw-primary{background:var(--accent);border-color:var(--accent);color:#0c1908}.public-welcome .pw-primary:hover{background:var(--accent)}\n.public-welcome a:focus-visible,.public-welcome summary:focus-visible,.public-welcome [tabindex]:focus-visible{outline:3px solid var(--focus);outline-offset:3px}\n.public-welcome .pw-skip{position:absolute;left:16px;top:-100px;z-index:1;background:var(--surface);padding:10px 16px;min-height:44px;border:1px solid var(--focus);border-radius:8px}.public-welcome .pw-skip:focus{top:8px}\n.public-welcome .pw-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;padding:32px 0}\n.public-welcome .pw-hero{min-width:0}.public-welcome .pw-eyebrow{font-size:12px;color:var(--accent);font-weight:750;letter-spacing:.08em;text-transform:uppercase;margin:0 0 12px}\n.public-welcome h1{font-size:clamp(28px,3.7vw,42px);line-height:1.13;letter-spacing:-.035em;margin:0 0 18px;max-width:15ch}\n.public-welcome .pw-value{color:var(--text-secondary);margin:0 0 20px;max-width:42ch;font-size:17px}\n.public-welcome .pw-access{color:var(--text-secondary);font-size:13px;max-width:43ch;margin:12px 0 0}\n.public-welcome .pw-demo-group{min-width:0;scroll-margin-top:16px}.public-welcome .pw-demo-nav{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin:0 0 10px}\n.public-welcome .pw-demo-nav a{display:flex;align-items:center;justify-content:center;min-height:44px;padding:6px;border-bottom:1px solid var(--border);font-size:13px;font-weight:650;color:var(--text-secondary);text-align:center}\n.public-welcome .pw-demo-nav a:hover{color:var(--accent)}\n.public-welcome .pw-demo{border-top:1px solid var(--border);padding:0 0 10px;scroll-margin-top:16px}\n.public-welcome .pw-demo>summary{min-height:58px;padding:12px 0;list-style:disclosure-closed inside;cursor:pointer}\n.public-welcome .pw-demo[open]>summary{list-style-type:disclosure-open;margin-bottom:8px}\n.public-welcome .pw-demo>summary h2{display:inline;font-size:20px;line-height:1.3;letter-spacing:-.02em;margin:0}\n.public-welcome .pw-index{font-size:12px;color:var(--accent);font-weight:700;margin-right:8px;vertical-align:middle}\n.public-welcome .pw-demo-note{font-size:12px;color:var(--text-secondary);margin:0 0 12px}\n.public-welcome .pw-conclusion{background:var(--surface);border-left:3px solid var(--accent);border-radius:0 12px 12px 0;padding:16px;margin:0 0 14px}\n.public-welcome h3{font-size:21px;line-height:1.3;margin:0 0 12px;letter-spacing:-.02em}\n.public-welcome .pw-conclusion p{margin:9px 0;color:var(--text-secondary);font-size:14px}.public-welcome .pw-conclusion p:last-child{margin-bottom:0}\n.public-welcome .pw-team-name{font-size:12px;font-weight:700;color:var(--accent);margin:0 0 8px}\n.public-welcome .pw-number{font-size:27px;font-weight:750;color:var(--value-color);font-variant-numeric:tabular-nums;line-height:1.2}\n.public-welcome .pw-metric-label{display:block;font-size:12px;color:var(--text-secondary);font-weight:450;margin-top:4px}\n.public-welcome .pw-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:12px 0}\n.public-welcome .pw-metrics>div{min-width:0}.public-welcome .pw-cost{border-left:2px solid var(--warning);padding-left:10px}\n.public-welcome .pw-detail{font-size:14px;margin:8px 0 12px}.public-welcome .pw-detail>summary{min-height:44px;padding:8px 0;color:var(--text-secondary);cursor:pointer}\n.public-welcome .pw-detail p{font-size:14px;color:var(--text-secondary)}\n.public-welcome .pw-roster{list-style:none;padding:0;margin:0}.public-welcome .pw-roster li{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;padding:9px 0;border-top:1px solid var(--border);align-items:center}\n.public-welcome .pw-asset{display:flex;align-items:center;gap:9px;min-width:0}.public-welcome .pw-position{display:inline-flex;align-items:center;justify-content:center;flex:0 0 38px;min-height:32px;padding:3px;border-radius:7px;background:var(--surface-elevated);font-size:11px;color:var(--text-secondary);font-weight:750}\n.public-welcome .pw-asset-copy{min-width:0;font-size:14px;font-weight:650}.public-welcome .pw-asset-copy small{display:block;color:var(--text-secondary);font-size:12px;font-weight:450}.public-welcome .pw-points{color:var(--value-color);font-variant-numeric:tabular-nums;font-size:14px;text-align:right}\n.public-welcome .pw-capital{padding-left:20px}.public-welcome .pw-capital li{margin:8px 0}.public-welcome .pw-capital small{display:block;color:var(--text-secondary);font-size:12px}\n.public-welcome .pw-package{padding:12px 0;border-top:1px solid var(--border)}.public-welcome .pw-package h3{font-size:14px;margin:0 0 8px;color:var(--text-secondary)}\n.public-welcome .pw-package ul{padding:0;margin:0;list-style:none}.public-welcome .pw-package li+li{margin-top:8px}\n.public-welcome .pw-side{padding:12px 0;border-top:1px solid var(--border)}.public-welcome .pw-side h3{font-size:16px;margin:0 0 6px}.public-welcome .pw-side p{font-size:14px;color:var(--text-secondary);margin:8px 0}\n.public-welcome .pw-side .pw-delta{color:var(--positive);font-weight:750;font-variant-numeric:tabular-nums}\n.public-welcome .pw-assessment{font-size:14px;color:var(--text-primary);margin:12px 0}.public-welcome .pw-assessment small{display:block;color:var(--text-secondary);font-size:12px;margin-top:4px}\n.public-welcome .pw-comparison{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:12px 0}.public-welcome .pw-comparison>div{min-width:0;border-top:1px solid var(--border);padding:12px 0}.public-welcome .pw-comparison h3{font-size:14px;margin:0 0 9px}.public-welcome .pw-comparison dl{margin:0}.public-welcome .pw-comparison dt{font-size:12px;color:var(--text-secondary)}.public-welcome .pw-comparison dd{margin:2px 0 8px;font-size:21px;font-weight:750;font-variant-numeric:tabular-nums;color:var(--value-color)}\n.public-welcome .pw-ranking{padding-left:24px;font-size:14px}.public-welcome .pw-ranking li{margin:8px 0}.public-welcome .pw-ranking span{color:var(--text-secondary)}\n.public-welcome .pw-scoring{margin:0;padding-left:20px}.public-welcome .pw-scoring li{margin:6px 0}\n.public-welcome .pw-setup{border-top:1px solid var(--border);padding:24px 0}.public-welcome .pw-setup h2{font-size:23px;line-height:1.3;margin:0 0 12px}.public-welcome .pw-setup p{max-width:70ch;color:var(--text-secondary)}\n.public-welcome .pw-account-actions{display:flex;gap:10px;flex-wrap:wrap;margin:14px 0}.public-welcome .pw-access-note{font-size:13px}.public-welcome .pw-footer{border-top:1px solid var(--border);padding-top:16px;color:var(--text-secondary);font-size:12px}\n.public-welcome :target{scroll-margin-top:16px}\n@media(max-width:760px){.public-welcome .pw-wrap{padding:0 16px 24px}.public-welcome .pw-header{min-height:66px}.public-welcome .pw-intro{grid-template-columns:minmax(0,1fr);gap:22px;padding:22px 0}.public-welcome h1{font-size:28px;max-width:18ch;margin-bottom:14px}.public-welcome .pw-value{font-size:16px;margin-bottom:16px}.public-welcome .pw-hero>.pw-primary{width:100%}.public-welcome .pw-conclusion{padding:13px}.public-welcome .pw-account-actions{display:grid;grid-template-columns:1fr}.public-welcome .pw-demo>summary h2{font-size:19px}.public-welcome .pw-number{font-size:25px}}\n@media(prefers-reduced-motion:reduce){.public-welcome{scroll-behavior:auto}}\n</style></head>\n<body class="public-welcome"><a class="pw-skip" href="#main">Skip to main content</a><div class="pw-wrap">\n<header class="pw-header"><a class="pw-brand" href="/welcome" aria-label="DTOS welcome"><span class="pw-brand-d" aria-hidden="true">D</span><span>TOS</span></a><a class="pw-action" href="/account/sign-in">Sign In</a></header>\n<main id="main" tabindex="-1"><div class="pw-intro"><section class="pw-hero" aria-labelledby="welcome-title">\n<p class="pw-eyebrow">Dynasty football · Sleeper</p><h1 id="welcome-title">A clearer view of your dynasty.</h1>\n<p class="pw-value">Understand your team, weigh both sides of a trade, and bring your own player values.</p>\n<a class="pw-action pw-primary" href="#demo">Explore the Demo</a>\n<p class="pw-access">Explore the read-only examples, or sign in to use your league.</p>\n</section><section class="pw-demo-group" id="demo" tabindex="-1" aria-label="Read-only product demonstrations">\n<nav class="pw-demo-nav" aria-label="Explore the demonstrations"><a href="#demo-team">Team</a><a href="#demo-trade">Trade</a><a href="#demo-values">Your values</a></nav>\n<details class="pw-demo" id="demo-team" open><summary><h2><span class="pw-index">01</span>Understand Your Team</h2></summary>\n<p class="pw-demo-note">Illustrative values and hypothetical rosters. Not live player valuations or actual trades.</p><article class="pw-conclusion"><p class="pw-team-name">Harbor Front Office · Demo Dynasty League</p>\n<h3>Three projected quarterbacks provide meaningful Superflex replacement cover.</h3><div class="pw-metrics"><div><b class="pw-number">0</b><span class="pw-metric-label">Highest projected starting lineup</span></div><div><b>RETOOL</b><span class="pw-metric-label">Selected goal in this example</span></div></div>\n<p>A comparative lineup rank is unavailable for this example.</p><p><b>Eligible backups:</b> Jalen Hurts (QB): 24 projected points; DeVonta Smith (WR): 7 projected points; Ja&#x27;Marr Chase (WR): 8 projected points; George Kittle (TE): 4 projected points</p><p class="pw-cost"><b>Keep in mind:</b> Using a reserve quarterback to improve receivers can remove that quarterback cover. Current points do not establish future availability.</p><p><b>Consider next:</b> Compare a receiver upgrade with its quarterback-depth cost before pursuing it.</p></article>\n<details class="pw-detail" id="demo-roster"><summary>Starting lineup and useful replacements</summary><p>Fictional week 5 projections under this example\'s rules. Bench players are not counted in the starting total.</p><h3>Starting lineup</h3><ul class="pw-roster"><li><span class="pw-asset"><span class="pw-position">QB</span><span class="pw-asset-copy">Josh Allen<small>Starting slot: QB</small></span></span><span class="pw-points">34 pts</span></li><li><span class="pw-asset"><span class="pw-position">QB</span><span class="pw-asset-copy">Lamar Jackson<small>Starting slot: SUPER_FLEX</small></span></span><span class="pw-points">30 pts</span></li><li><span class="pw-asset"><span class="pw-position">RB</span><span class="pw-asset-copy">Bijan Robinson<small>Starting slot: FLEX</small></span></span><span class="pw-points">16 pts</span></li><li><span class="pw-asset"><span class="pw-position">TE</span><span class="pw-asset-copy">Brock Bowers<small>Starting slot: TE</small></span></span><span class="pw-points">10 pts</span></li><li><span class="pw-asset"><span class="pw-position">WR</span><span class="pw-asset-copy">CeeDee Lamb<small>Starting slot: WR</small></span></span><span class="pw-points">10 pts</span></li><li><span class="pw-asset"><span class="pw-position">RB</span><span class="pw-asset-copy">Christian McCaffrey<small>Starting slot: RB</small></span></span><span class="pw-points">8 pts</span></li></ul><h3>Available replacements</h3><ul class="pw-roster"><li><span class="pw-asset"><span class="pw-position">QB</span><span class="pw-asset-copy">Jalen Hurts</span></span><span class="pw-points">24 pts</span></li><li><span class="pw-asset"><span class="pw-position">WR</span><span class="pw-asset-copy">DeVonta Smith</span></span><span class="pw-points">7 pts</span></li><li><span class="pw-asset"><span class="pw-position">WR</span><span class="pw-asset-copy">Ja&#x27;Marr Chase</span></span><span class="pw-points">8 pts</span></li><li><span class="pw-asset"><span class="pw-position">TE</span><span class="pw-asset-copy">George Kittle</span></span><span class="pw-points">4 pts</span></li></ul></details>\n<details class="pw-detail" id="demo-capital"><summary>Exact draft capital</summary><ul class="pw-capital"><li><b>2028 first · originally Summit Front Office</b><small>Original franchise: Summit Front Office · Current owner: Harbor Front Office</small></li></ul><p>Original franchise and current ownership remain separate. A pick is not guaranteed to be early or to produce a particular player.</p></details>\n</details>\n<details class="pw-demo" id="demo-trade"><summary><h2><span class="pw-index">02</span>Make Better Trades</h2></summary>\n<p class="pw-demo-note">Illustrative values and hypothetical rosters. Not live player valuations or actual trades.</p><p class="pw-team-name">Hypothetical offer · Harbor Front Office and Summit Front Office</p>\n<section class="pw-package"><h3>You Send</h3><ul><li><span class="pw-asset"><span class="pw-position">QB</span><span class="pw-asset-copy">Lamar Jackson</span></span></li></ul></section><section class="pw-package"><h3>You Receive</h3><ul><li><span class="pw-asset"><span class="pw-position">WR</span><span class="pw-asset-copy">Justin Jefferson</span></span></li></ul></section><div class="pw-metrics"><div><b class="pw-number">0</b><span class="pw-metric-label">You send · neutral Market units</span></div><div><b class="pw-number">Unavailable</b><span class="pw-metric-label">You receive · neutral Market units</span></div></div><p class="pw-assessment"><b>WORTH PURSUING</b><small>Eligible in this fictional evaluation. An evaluated hypothetical offer, not a prediction that another manager accepts. Both rosters are evaluated using the same neutral evidence.</small></p>\n<section class="pw-side"><h3>Harbor Front Office</h3><p><span class="pw-delta">+12 projected points</span> · strongest legal lineup 108 → 120</p><p><b>Benefit:</b> The incoming receiver improves the best legal starting lineup.</p><p class="pw-cost"><b>Cost:</b> Sending a starting quarterback uses the third quarterback as the Superflex starter; there is no further quarterback replacement in this example.</p></section><section class="pw-side"><h3>Summit Front Office</h3><p><span class="pw-delta">+4 projected points</span> · strongest legal lineup 112 → 116</p><p><b>Benefit:</b> The incoming quarterback improves the best legal starting lineup.</p><p class="pw-cost"><b>Cost:</b> Summit gives up its highest-projected receiver and relies on its other receivers to cover WR and FLEX.</p></section><p class="pw-demo-note">A plausible offer is not a prediction that the other manager will accept. Projected gains are not guaranteed results.</p>\n</details>\n<details class="pw-demo" id="demo-values"><summary><h2><span class="pw-index">03</span>Build Your Own DTOS</h2></summary>\n<p class="pw-demo-note">Illustrative values and hypothetical rosters. Not live player valuations or actual trades.</p><p class="pw-team-name">The same hypothetical offer · Harbor Front Office</p><p>Your ranking changes your view of this offer. Personal values can differ while neutral Market prices and the other manager\'s valuations stay unchanged.</p><p class="pw-demo-note">A read-only excerpt from the full example ranking, not an editor. Unpriced future picks remain capital facts; they are not assigned invented personal prices.</p>\n<div class="pw-comparison"><div><h3>Neutral DTOS · Market units</h3><dl><dt>You Send</dt><dd>0</dd><dt>You Receive</dt><dd>528</dd></dl></div><div><h3>Custom DTOS · personal units</h3><dl><dt>You Send</dt><dd>Unavailable</dd><dt>You Receive</dt><dd>785</dd></dl></div></div><p class="pw-cost">This is a two-asset excerpt from the complete example order. Personal preference is not evidence of an opponent valuation or trade acceptance.</p>\n<details class="pw-detail"><summary>See the ranking move and what stays unchanged</summary><p>Move Justin Jefferson to first in the full example ranking. The saved-cohort Market value curve assigns that rank its existing highest value.</p><p>All compatible priced player assets in this fictional fixture. The owned future picks have no supplied Market quote and receive no personal price.</p><h3>Before the personal move</h3><ol class="pw-ranking"><li value="5">Justin Jefferson <span>· 528 personal units</span></li><li value="7">Lamar Jackson <span>· 528 personal units</span></li></ol><h3>After the personal move</h3><ol class="pw-ranking"><li value="1">Justin Jefferson <span>· 785 personal units</span></li><li value="7">Lamar Jackson <span>· 528 personal units</span></li></ol><ul><li>Neutral Market prices</li><li>Both legal-lineup calculations</li><li>Opponent neutral valuation</li></ul><p>In your own DTOS, you can save optional tiers, targets, players you prefer not to acquire, and specific assets to protect. Those opinions stay separate from temporary Trade choices. Custom values require compatible Market evidence; missing prices do not become zero.</p></details>\n</details>\n<details class="pw-detail" id="demo-evidence"><summary>Example scoring, source and limitations</summary><p>Demonstration data · fictional league · not current player advice · 2026 · Week 5. Full PPR · 4-point passing touchdowns · Superflex</p><p>Required starting slots: QB, RB, WR, TE, FLEX, SUPER_FLEX.</p><ul class="pw-scoring"><li>Passing yard: 0.04 points</li><li>Passing touchdown: 4 points</li><li>Interception thrown: -2 points</li><li>Rushing yard: 0.1 points</li><li>Rushing touchdown: 6 points</li><li>Reception: 1 points</li><li>Receiving yard: 0.1 points</li><li>Receiving touchdown: 6 points</li><li>Fumble lost: -2 points</li></ul><ul><li>Real player names identify illustrative roster slots only. All prices, projected statistics, rosters and transactions are hypothetical; they are not actual player assessments.</li><li>Frozen Week 5 example; supported changes are not promised results.</li><li>No injury probabilities, playoff odds or multi-season forecast are inferred.</li><li>Reserve points summarize useful disjoint legal replacements, not a second complete starting lineup.</li></ul><p>Frozen fictional fixture: public-football-demo-v1 · version 1. No live analysis runs when you open or explore this page.</p></details>\n</section></div>\n<section class="pw-setup" aria-labelledby="setup-title"><h2 id="setup-title">Use DTOS with your Sleeper league</h2><p>Create your DTOS account, enter your public Sleeper username, then review your franchise match. Your DTOS account is separate from Sleeper; resolving a username does not independently prove control of that Sleeper account.</p><p><b>Already have an account?</b> Use the existing account destinations below.</p><nav class="pw-account-actions" aria-label="Account destinations"><a class="pw-action" href="/account/sign-in">Sign In</a><a class="pw-action" href="/account/create">Create Account</a><a class="pw-action" href="/account/recover">Account Recovery</a></nav><p class="pw-access-note">Account creation is available. Recommendations depend on supported league and Market evidence; service availability can vary.</p></section>\n</main><footer class="pw-footer">DTOS · Dynasty front office intelligence. Real names are used only to identify players in fictional examples. No affiliation, sponsorship or endorsement by the players, their teams or the NFL is implied. These examples are not your league, saved rankings or current player advice.</footer></div></body></html>'

