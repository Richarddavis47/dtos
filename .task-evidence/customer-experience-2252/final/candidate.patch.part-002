+            comparison_identity=None, provider_evidence=[], admission_reason='Supported quote', quote_age_seconds=0)
+        markup = _quote_card(row, 'Player')
+        self.assertIn('Nov 3, 2026 · 18:01 UTC', default_text(markup))
