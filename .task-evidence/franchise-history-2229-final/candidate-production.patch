+from tests import test_trade_workspace_batch1 as boundary
+from tests import test_trade_discovery_repair as discovery
+from tools.validation.browser_runtime import launch_chromium
+
+
+@contextmanager
+def independent_journey():
+    """Dispose every source/account/browser owned by one viewport."""
+    import dtos_app
+    from src.platform.memory_reclamation import release_unused_allocator_pages
+
+    try:
+        with ExitStack() as scope:
+            source = discovery.DiscoveryRepairTests()
+            source.setUp()
+            scope.callback(source.doCleanups)
+            auth = boundary.AuthenticatedTradeBoundaryTests()
+            auth.setUp()
+            scope.callback(auth.doCleanups)
+            scope.callback(auth.client.close)
+            auth.data = source.data
+            auth.client.app.router.routes.clear()
+            auth.client.app.include_router(create_trades_router(
+                ensure_fresh=AsyncMock(), require_data=lambda: auth.data,
+                page=dtos_app.page))
+            scope.enter_context(patch.object(dtos_app, "account_store", auth.store))
+            scope.enter_context(patch("src.core.projection_intelligence.projection_service", source.fixture.reader))
+            engine = scope.enter_context(sync_playwright())
+            browser = launch_chromium(engine, headless=True)
+            scope.callback(browser.close)
+            yield auth, browser
+    finally:
+        gc.collect()
+        release_unused_allocator_pages()
+
