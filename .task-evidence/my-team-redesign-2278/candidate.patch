@@ -0,0 +1,96 @@
+[data-my-team-sections] .thq-header {
+  padding: 0;
+  border: 0;
+  background: transparent;
+  margin: 0 0 12px;
+}
+
+[data-my-team-sections] .thq-header > div:last-child { margin-top: 0; }
+[data-my-team-sections] .thq-title h1 { font-size: clamp(24px, 5vw, 34px); line-height: 1.15; }
+[data-my-team-sections] .thq-header .thq-record-link { min-height: 44px; color: var(--text-secondary); }
+[data-my-team-sections] .thq-strategy small { display: block; margin-top: 8px; color: var(--text-secondary); }
+.thq-team-goal h2, .thq-tab-heading { margin: 0 0 10px; font-size: 20px; }
+
+.thq-tabs {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 2px;
+  padding: 3px;
+  background: var(--surface-elevated);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  margin-bottom: 12px;
+}
+
+.thq-tabs a {
+  display: grid;
+  place-items: center;
+  text-align: center;
+  min-height: 44px;
+  color: var(--text);
+  font-weight: 700;
+  border-radius: var(--radius-sm);
+  padding: 4px;
+  text-decoration: none;
+}
+
+.thq-tabs a[aria-current="location"] { background: var(--accent); color: #0c1908; }
+[data-team-section][hidden] { display: none !important; }
+[data-team-section] [id] { scroll-margin-top: 64px; scroll-margin-bottom: 96px; }
+.thq-lineup-deadline { font-weight: 650; color: var(--gold); margin: 4px 0 8px; }
+
+.thq-bye-week {
+  margin: 0 0 10px;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  background: var(--surface);
+}
+
+.thq-bye-week > summary {
+  display: flex;
+  gap: 12px;
+  justify-content: space-between;
+  align-items: center;
+  min-height: 48px;
+  cursor: pointer;
+  padding: 12px;
+  list-style: none;
+}
+
+.thq-bye-week > summary::-webkit-details-marker { display: none; }
+.thq-bye-week > summary::after {
+  content: "";
+  width: 8px;
+  height: 8px;
+  flex: 0 0 8px;
+  border: solid currentColor;
+  border-width: 0 2px 2px 0;
+  transform: rotate(45deg);
+  margin: 0 3px 4px 0;
+}
+.thq-bye-week[open] > summary::after { transform: rotate(225deg); margin-bottom: 0; }
+.thq-bye-week > summary b { display: block; font-size: clamp(17px, 4.5vw, 22px); }
+.thq-bye-week > summary small, .thq-bye-move small { display: block; color: var(--text-secondary); font-size: .9rem; }
+.thq-bye-content { padding: 0 12px 12px; }
+.thq-bye-content p { margin: 6px 0; }
+.thq-bye-content ul { padding-inline-start: 20px; }
+.thq-bye-moves { display: grid; gap: 8px; margin: 8px 0; }
+
+.thq-bye-move {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
+  gap: 8px;
+  align-items: center;
+  padding: 9px;
+  border-radius: var(--radius-md);
+  background: var(--surface-elevated);
+}
+
+.thq-bye-slot { grid-column: 1 / -1; color: var(--text-secondary); font-size: .875rem; font-weight: 700; }
+.thq-bye-move p { margin: 0; min-width: 0; }
+.thq-bye-arrow { padding-inline: 2px; }
+.thq-bye-warning { color: var(--gold); }
+.thq-bye-actions { display: grid; gap: 6px; margin-top: 8px; }
+.thq-bye-actions .thq-action { justify-content: center; text-align: center; text-decoration: none; }
+.thq-bye-actions .thq-action:first-child { background: var(--accent); color: #0c1908; border-color: var(--accent); }
+#upcoming-byes > details:not(.thq-bye-week) > summary { min-height: 44px; cursor: pointer; align-content: center; }
