+        row = self.row(fixtures.PICK)
+        self.assertEqual(row['value'], 100)
+        self.assertIn('originally', row['asset_name'])
+
+    def test_same_instant_conflicting_prices_are_unknown(self):
+        self.capture(value=100)
+        self.capture(value=800)
