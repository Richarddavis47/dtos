+        row = self.row()
+        self.assertIsNone(row['value'])
+        self.assertIsNone(row['retained_observation'])
+        response = self.f.client.get('/trades/history/'+fixtures.ROOT)
+        self.assertNotIn('future-private-quote',response.text)
+
