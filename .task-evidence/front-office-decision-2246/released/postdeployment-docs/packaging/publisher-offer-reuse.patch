+                stack.enter_context(patch.object(p, name, return_value={'passed': True}))
+            comparison = stack.enter_context(patch.object(p, 'verify_offer_comparison', wraps=p.verify_offer_comparison))
+            local = stack.enter_context(patch.object(p, 'verify_local_recovery', side_effect=ReachedRecovery))
+            if mode == 'complete':
