+    record = view['peer_record']
+    weeks = record['weeks']
+    expected = view['expected_weeks']
+    coverage = f"{len(weeks)}/{len(expected)} completed regular-season weeks used." if expected else ''
+    summary = (
+        f"Wins: {record['wins']} · Losses: {record['losses']} · Ties: {record['ties']}."
