+        data["league"].update(
+            roster_positions=slots,
+            scoring_settings={
+                "pass_yd": 1,
+                "rush_yd": 1,
+                "rec_yd": 1,
+                "fgm": 1,
+                "sack": 1,
+            },
+        )
+        data["scoring_settings"] = data["league"]["scoring_settings"]
+        stats = {
+            "QB": "pass_yd",
+            "RB": "rush_yd",
+            "WR": "rec_yd",
+            "TE": "rec_yd",
+            "K": "fgm",
+            "DEF": "sack",
+        }
+        self.rows = []
+        for team in data["teams"]:
+            rid = team["roster_id"]
+            for player in team["players"]:
+                player.update(status="Active", fantasy_positions=["QB"])
+                data["players"][player["id"]].update(
