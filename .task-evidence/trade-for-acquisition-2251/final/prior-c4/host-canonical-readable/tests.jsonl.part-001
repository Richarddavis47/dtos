{"event": "failure", "test": "test_canonical_harness_lifecycle.CanonicalHarnessLifecycleTests.test_ci_budget_and_resource_contract_remain_bounded", "time": 1794528070.9329977, "pid": 32, "rss": 409747456, "cgroup": 469041152, "error_type": "AssertionError", "error_text": "'        timeout-minutes: 25\\n' not found in 'name: Product browser journeys\\n\\non:\\n  pull_request:\\n    branches: [main]\\n  workflow_dispatch:\\n\\npermissions:\\n  contents: read\\n\\n# Validation driver GC budget only; Python/Chromium and the 2 GiB gate stay intact.\\nenv:\\n  NODE_OPTIONS: --max-old-space-size=256\\n\\njobs:\\n  product-browser:\\n    runs-on: ubuntu-24.04\\n    # Run43124548703 passed757main tests, then hit the30-minute job cap\\n    # during retainedhistory after255seconds of checkout. Preserve every\\n    # step/2GiB assertion and allow the measured complete sequence to finish.\\n    timeout-minutes: 45\\n    steps:\\n      - uses: actions/checkout@v4\\n        with:\\n          ref: ${{ github.event.pull_request.head.sha || github.sha }}\\n          fetch-depth: 0\\n      - uses: actions/setup-python@v5\\n        with:\\n          python-version: \\'3.12\\'\\n      - name: Prepare runner-owned Trade evidence directories\\n        run: mkdir -p .validation/trade-resource/fixture .validation/trade-resource/evidence/browser\\n      - name: Build bounded browser validation dependencies\\n        run: docker build -f tools/validation/containers/browser.Dockerfile -t dtos-browser-validation .\\n      - name: Authenticated product, interaction and accessibility contracts\\n        # Run43327175874 hit25minutes after735of762start markers, without a\\n        # completed test summary. Preserve the whole corpus and every assertion.\\n        # This bounded batch allowance changes no application/worker timeout,\\n        # search budget, performance threshold,2GiB limit or two-CPU enforcement.\\n        timeout-minutes: 35\\n        run: |\\n          docker run --rm --memory=2g --memory-swap=2g --cpus=2 --network=none -e NODE_OPTIONS -e DTOS_TRADE_RESOURCE_BROWSER_EVIDENCE=.validation/trade-resource/evidence/browser -e DTOS_LINEUP_DETAIL_EVIDENCE=.validation/trade-resource/evidence/browser/lineups -e DTOS_TEAM_NEED_EVIDENCE=.validation/trade-resource/evidence/browser/team-need -e DTOS_A"}
