+        observations = tuple(
+            replace(
+                o,
+                observed_at=stamp,
+                metadata={
+                    **o.metadata,
+                    **(
+                        {
+                            "comparison_semantics": {
+                                **o.metadata["comparison_semantics"],
+                                "format_key": "incompatible",
+                            }
+                        }
