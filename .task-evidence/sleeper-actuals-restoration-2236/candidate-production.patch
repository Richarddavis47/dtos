+    if (str(result.get('league_id') or '') != lid
+            or str(result.get('season')) != str(league.get('season'))
+            or result.get('scoring_fingerprint') != scoring_identity(scoring)):
+        return result
     attach_sleeper_actuals(data, result)
+    if production is None:
